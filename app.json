{
  "expo": {
    "name": "VOLT Academia",
    "slug": "volt-academia",
    "scheme": "volt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0C"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0C"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "VOLT Academia",
      "shortName": "VOLT",
      "backgroundColor": "#0B0B0C",
      "themeColor": "#0B0B0C"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O VOLT usa suas fotos para comparar sua evolução.",
          "cameraPermission": "O VOLT usa a câmera para registrar suas fotos de progresso."
        }
      ]
    ],
    "backgroundColor": "#0B0B0C"
  }
}